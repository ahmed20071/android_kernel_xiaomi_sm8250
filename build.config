#
# Alioth Ultra Kernel Build Configurations
# Different variants for different ROMs
#

# AOSP Variant
CONFIG_AOSP=y
CONFIG_MIUI_DRIVERS=n
CONFIG_HYPEROS_DRIVERS=n

# MIUI/HyperOS Variant
# CONFIG_AOSP=n
# CONFIG_MIUI_DRIVERS=y
# CONFIG_HYPEROS_DRIVERS=y

# Root Manager Selection (choose one)
# CONFIG_KSU=y
# CONFIG_SUKISU=y
# CONFIG_RESUKISU=y
# CONFIG_MAGISK=y
# CONFIG_NO_ROOT=y

# Performance Profile (choose one)
# CONFIG_PERF_MAX=y
# CONFIG_PERF_BALANCED=y
# CONFIG_PERF_BATTERY=y
