#
# Alioth Ultra Custom Modules
#

# Performance Drivers
CONFIG_ALIOTH_PERF=y
CONFIG_ALIOTH_RAM=y
CONFIG_ALIOTH_GPU=y
CONFIG_ALIOTH_CPU=y

# Root Managers
CONFIG_KSU=y
CONFIG_KSU_DEBUG=y
CONFIG_KSU_ALLOWLIST_WORKAROUND=y
CONFIG_SUKISU=y
CONFIG_SUKISU_KPM=y
CONFIG_KPM=y
CONFIG_SUSFS=y
CONFIG_SUSFS_SUS_SU=y
CONFIG_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_SUSFS_AUTO_ADD_TRY_SUS_MOUNT_BIND=y

# VSync/FSync Control
CONFIG_DYNAMIC_FSYNC=y
CONFIG_FSYNC_CONTROL=y
CONFIG_VSYNC_CONTROL=y
CONFIG_DYNAMIC_VSYNC=y
CONFIG_VSYNC_DISABLE=y

# Performance Features
CONFIG_CPU_BOOST=y
CONFIG_CPU_INPUT_BOOST=y
CONFIG_GPU_BOOST=y
CONFIG_GPU_INPUT_BOOST=y
CONFIG_IO_BOOST=y
CONFIG_INPUT_BOOST=y

# Memory
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4HC=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# I/O
CONFIG_DEFAULT_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y

# Networking
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR2=y
CONFIG_DEFAULT_BBR=y
CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y
CONFIG_WIREGUARD=y

# Security (allow toggling)
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=0
CONFIG_SECURITY_SELINUX_DISABLE=y

# Disable debug overhead
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_FS=n
CONFIG_DYNAMIC_DEBUG=n
